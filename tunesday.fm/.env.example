# Required
TUNESDAY_FM_BASE_URL=https://tunesday.fm
TUNESDAY_FM_SESSION_SECRET=change-me-to-a-long-random-string
TUNESDAY_FM_SMTP_HOST=smtp.example.com
TUNESDAY_FM_SMTP_USER=notifications@example.com
TUNESDAY_FM_SMTP_PASS=your-smtp-password

# Optional
TUNESDAY_FM_LISTEN_ADDR=:8080
TUNESDAY_FM_DATA_DIR=/data
TUNESDAY_FM_SESSION_SECURE=true
TUNESDAY_FM_BCRYPT_COST=10
TUNESDAY_FM_SMTP_PORT=587
TUNESDAY_FM_SMTP_FROM=noreply@tunesday.fm
