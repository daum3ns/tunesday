# Required
TUNESDAY_ONLINE_BASE_URL=https://tunesday.online
TUNESDAY_ONLINE_SESSION_SECRET=change-me-to-a-long-random-string
TUNESDAY_ONLINE_SMTP_HOST=smtp.example.com
TUNESDAY_ONLINE_SMTP_USER=notifications@example.com
TUNESDAY_ONLINE_SMTP_PASS=your-smtp-password

# Optional
TUNESDAY_ONLINE_LISTEN_ADDR=:8080
TUNESDAY_ONLINE_DATA_DIR=/data
TUNESDAY_ONLINE_SESSION_SECURE=true
TUNESDAY_ONLINE_BCRYPT_COST=10
TUNESDAY_ONLINE_SMTP_PORT=587
TUNESDAY_ONLINE_SMTP_FROM=noreply@tunesday.online

# Optional: path to the yt-dlp binary (radio stream mode + title lookups)
# TUNESDAY_ONLINE_YTDLP_PATH=yt-dlp
